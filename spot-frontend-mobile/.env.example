API_URL=http://localhost:3000/api
SOCKET_URL=http://localhost:3000
GOOGLE_MAPS_KEY=your-key
ENV=development

# Read via process.env.EXPO_PUBLIC_* (Expo's built-in .env support, SDK 49+
# — Metro inlines EXPO_PUBLIC_-prefixed vars at build time, no extra
# package needed). Get a free key at https://myprojects.geoapify.com/
EXPO_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-key
