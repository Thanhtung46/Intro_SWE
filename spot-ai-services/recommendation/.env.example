# Server
PORT=5001

# Database — same Supabase Postgres spot-backend uses (read-only access recommended)
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_PASSWORD
DB_SSL=true
DB_POOL_MAX=5

# Shared secret spot-backend must send as `X-Internal-Service-Key`.
# This service is not reachable from the public internet or any frontend directly.
INTERNAL_SERVICE_KEY=change-me
