# Server
PORT=5003

# Gemini (text + multimodal/audio understanding) — see research.md decision 3
GEMINI_API_KEY=your-key

# Redis — conversation + pending-action state (research.md decision 4)
REDIS_URL=redis://localhost:6379/0

# spot-backend — this service calls back into its matchmaking API on the
# player's behalf, using the forwarded X-Player-Access-Token (research.md decision 2)
BACKEND_URL=http://localhost:3000

# Shared secret spot-backend must send as `X-Internal-Service-Key`.
# This service is not reachable from the public internet or any frontend directly.
INTERNAL_SERVICE_KEY=change-me
