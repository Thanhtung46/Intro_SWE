{
  "info": {
    "_postman_id": "b7d4f2e1-8c90-4a11-matchmaking-spot",
    "name": "SPOT Matchmaking",
    "description": "Chỉ API kèo `/matches`.\n\n1. Sửa `hostEmail` / `joinerEmail` (account đã verify) hoặc chạy Login.\n2. Login Host rồi Login Joiner (script lưu token).\n3. Host: Create AUTO hoặc APPROVAL → `matchId` tự lưu.\n4. Joiner: GET list → Join → Favorite.\n5. Host: requests / accept / kick / patch / cancel.\n\nHeader: `Authorization: Bearer` theo folder (hostToken / joinerToken).\n`startsAt`/`endsAt`/`courtName` collection tự set (tuần sau, tránh 409 sân trùng).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const start = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
          "start.setMinutes(0, 0, 0);",
          "pm.collectionVariables.set('startsAt', start.toISOString());",
          "pm.collectionVariables.set('endsAt', new Date(start.getTime() + 2 * 60 * 60 * 1000).toISOString());",
          "if (!pm.collectionVariables.get('courtName')) {",
          "  pm.collectionVariables.set('courtName', 'P-' + Date.now().toString().slice(-6));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "password", "value": "Password1!" },
    { "key": "hostEmail", "value": "host.spot@example.com" },
    { "key": "joinerEmail", "value": "joiner.spot@example.com" },
    { "key": "hostToken", "value": "" },
    { "key": "joinerToken", "value": "" },
    { "key": "hostUserId", "value": "" },
    { "key": "joinerUserId", "value": "" },
    { "key": "matchId", "value": "1" },
    { "key": "requestId", "value": "1" },
    { "key": "startsAt", "value": "2026-09-20T02:00:00.000Z" },
    { "key": "endsAt", "value": "2026-09-20T04:00:00.000Z" },
    { "key": "courtName", "value": "1" },
    { "key": "coverUrl", "value": "https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=800" }
  ],
  "item": [
    {
      "name": "0. Login (lấy token)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Login Host",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('hostToken', json.accessToken);",
                  "if (json.user && json.user.userId != null) pm.collectionVariables.set('hostUserId', String(json.user.userId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{hostEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Joiner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('joinerToken', json.accessToken);",
                  "if (json.user && json.user.userId != null) pm.collectionVariables.set('joinerUserId', String(json.user.userId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{joinerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Host — tạo / sửa / duyệt",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{hostToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "POST /matches  AUTO + cover",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.match && json.match.matchId != null) pm.collectionVariables.set('matchId', String(json.match.matchId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"FOOTBALL\",\n  \"format\": \"SEVEN_A_SIDE\",\n  \"title\": \"Saturday 7v7 AUTO\",\n  \"notes\": \"Bring both shirts\",\n  \"coverUrl\": \"{{coverUrl}}\",\n  \"venueName\": \"San ABC\",\n  \"venueAddress\": \"123 Nguyen Van Linh, Q7, TP.HCM\",\n  \"latitude\": 10.729,\n  \"longitude\": 106.721,\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\",\n  \"maxPlayers\": 14,\n  \"skillMin\": \"REC_BASIC\",\n  \"skillMax\": \"SEMI_PRO\",\n  \"feeType\": \"SPLIT_EVENLY\",\n  \"priceMin\": 1400000,\n  \"joinMode\": \"AUTO\",\n  \"courts\": [{ \"name\": \"{{courtName}}\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches"
          }
        },
        {
          "name": "POST /matches  APPROVAL + cover",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('courtName', 'A-' + Date.now().toString().slice(-6));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.match && json.match.matchId != null) pm.collectionVariables.set('matchId', String(json.match.matchId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"FOOTBALL\",\n  \"format\": \"SEVEN_A_SIDE\",\n  \"title\": \"Sunday 7v7 APPROVAL\",\n  \"notes\": \"Host will approve\",\n  \"coverUrl\": \"{{coverUrl}}\",\n  \"venueName\": \"San ABC\",\n  \"venueAddress\": \"123 Nguyen Van Linh, Q7, TP.HCM\",\n  \"latitude\": 10.729,\n  \"longitude\": 106.721,\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\",\n  \"maxPlayers\": 14,\n  \"skillMin\": \"REC_BASIC\",\n  \"skillMax\": \"SEMI_PRO\",\n  \"feeType\": \"SPLIT_EVENLY\",\n  \"priceMin\": 1400000,\n  \"joinMode\": \"APPROVAL\",\n  \"courts\": [{ \"name\": \"{{courtName}}\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches"
          }
        },
        {
          "name": "POST /matches  BADMINTON GENDER_RANGE",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('courtName', 'B-' + Date.now().toString().slice(-6));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.match && json.match.matchId != null) pm.collectionVariables.set('matchId', String(json.match.matchId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"BADMINTON\",\n  \"format\": \"DOUBLES\",\n  \"title\": \"Evening doubles\",\n  \"coverUrl\": \"https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=800\",\n  \"venueName\": \"San Cau Long Q7\",\n  \"venueAddress\": \"45 Nguyen Thi Thap, Q7, TP.HCM\",\n  \"latitude\": 10.741,\n  \"longitude\": 106.718,\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\",\n  \"maxPlayers\": 4,\n  \"skillMin\": \"BEGINNER\",\n  \"skillMax\": \"AVERAGE_PLUS\",\n  \"feeType\": \"GENDER_RANGE\",\n  \"priceMin\": 80000,\n  \"priceMax\": 120000,\n  \"joinMode\": \"AUTO\",\n  \"courts\": [{ \"name\": \"{{courtName}}\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches"
          }
        },
        {
          "name": "GET /matches/mine?tab=active",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/mine?tab=active"
          }
        },
        {
          "name": "GET /matches/mine?tab=completed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/mine?tab=completed"
          }
        },
        {
          "name": "GET /matches/:id  (host)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}"
          }
        },
        {
          "name": "GET /matches/:id/requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/requests"
          }
        },
        {
          "name": "POST .../requests/:requestId/accept",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/requests/{{requestId}}/accept"
          }
        },
        {
          "name": "POST .../requests/:requestId/reject",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/requests/{{requestId}}/reject"
          }
        },
        {
          "name": "POST .../participants/:userId/kick",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/participants/{{joinerUserId}}/kick"
          }
        },
        {
          "name": "PATCH /matches/:id",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Evening 7v7 updated\",\n  \"notes\": \"Kick-off 15 minutes earlier\",\n  \"coverUrl\": \"{{coverUrl}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches/{{matchId}}"
          }
        },
        {
          "name": "POST /matches/:id/cancel",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Joiner — list / join / tim",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{joinerToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "GET /matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches?sport=FOOTBALL&limit=20&offset=0"
          }
        },
        {
          "name": "GET /users/:id (host profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{hostUserId}}",
            "description": "Không có email/SĐT. `rating` null, `reviewCount` 0."
          }
        },
        {
          "name": "GET /matches?hostUserId=",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches?hostUserId={{hostUserId}}"
          }
        },
        {
          "name": "GET /matches  filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches?sport=FOOTBALL&date=2026-08-22&timeFrom=19:00&timeTo=21:00&skill=REC_BASIC&skill=SEMI_PRO&priceMin=20000&priceMax=150000&location=San%20ABC"
          }
        },
        {
          "name": "GET /matches?favorited=true",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches?favorited=true&location=Q7",
            "description": "Sheet filter: tim = kèo đã favorite. Kết hợp `location`."
          }
        },
        {
          "name": "GET /matches/:id  (trước join)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}"
          }
        },
        {
          "name": "POST /matches/:id/join  solo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.request && json.request.requestId != null) pm.collectionVariables.set('requestId', String(json.request.requestId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches/{{matchId}}/join"
          }
        },
        {
          "name": "POST /matches/:id/join  + guests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.request && json.request.requestId != null) pm.collectionVariables.set('requestId', String(json.request.requestId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Can I bring friends?\",\n  \"phoneNumber\": \"0901000002\",\n  \"guests\": [\n    {\n      \"name\": \"Minh\",\n      \"skill\": \"REC_BASIC\",\n      \"gender\": \"male\",\n      \"phoneNumber\": \"0901111111\"\n    },\n    {\n      \"name\": \"Lan\",\n      \"skill\": \"LEARNING\",\n      \"gender\": \"female\",\n      \"phoneNumber\": \"0902222222\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/matches/{{matchId}}/join"
          }
        },
        {
          "name": "GET /matches/:id  (sau join)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}"
          }
        },
        {
          "name": "POST /matches/:id/favorite",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/favorite"
          }
        },
        {
          "name": "DELETE /matches/:id/favorite",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/matches/{{matchId}}/favorite"
          }
        }
      ]
    }
  ]
}
