        {
          "name": "0. Randomize test accounts",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('hostEmail', 'host.spot.' + stamp + '@example.com');",
                  "pm.collectionVariables.set('joinerEmail', 'joiner.spot.' + stamp + '@example.com');",
                  "pm.collectionVariables.set('hostPhone', '090' + String(stamp).slice(-7));",
                  "pm.collectionVariables.set('joinerPhone', '091' + String(stamp).slice(-7));",
                  "pm.collectionVariables.set('courtName', 'P-' + String(stamp).slice(-6));",
                  "console.log('hostEmail', pm.collectionVariables.get('hostEmail'));",
                  "console.log('joinerEmail', pm.collectionVariables.get('joinerEmail'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Tạo email + SĐT mới (tránh 409). Xem Console."
          }
        }
      ]
