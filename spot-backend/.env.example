# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database — local OR hosted (Supabase)
# Prefer Session pooler if direct db.* times out (direct is often IPv6-only).
# Option A: paste URI from Supabase → Database → Connect → Session pooler
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Option B: discrete fields (used when DB_HOST is set; wins over shell DATABASE_URL)
DATABASE_URL=
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_PASSWORD
DB_SSL=true
DB_POOL_MAX=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only: include debugOtp in register/resend JSON + log code. Never enable in production.
OTP_DEBUG=false

# Payment (dev stub gateway — never enable in production without real keys)
PAYMENT_DEBUG=false
PAYMENT_TTL_SECONDS=900
PAYMENT_EXPIRY_INTERVAL_MS=60000

# Email (Gmail SMTP — use an App Password, not your normal Gmail password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
EMAIL_FROM="SPOT <your.gmail@gmail.com>"
SUPPORT_EMAIL=support@spot.local

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Public URL for avatar/verification-doc links (mobile devices: use LAN IP, no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# Supabase Storage — avatar / verification-document / facility photo
# uploads all go here now (must be a public bucket; create it once in the
# Supabase dashboard under Storage). Project → Settings → API for URL +
# service_role key (server-side only, never expose to FE).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=spot-uploads

# Firebase
FIREBASE_PROJECT_ID=your-project
FIREBASE_PRIVATE_KEY=your-key

# AWS S3 (unused — file uploads use Supabase Storage above)
AWS_REGION=ap-southeast-1
AWS_BUCKET=spot-images
AWS_ACCESS_KEY=your-key
AWS_SECRET_KEY=your-secret

# External APIs
GOOGLE_MAPS_API_KEY=your-key
GEMINI_API_KEY=your-key
OPENAI_API_KEY=your-key

# AI Services
RECOMMENDATION_SERVICE_URL=http://localhost:5001
NOSHOW_SERVICE_URL=http://localhost:5002
NLP_SERVICE_URL=http://localhost:5003
# Shared secret sent as X-Internal-Service-Key when calling nlp-assistant
# (research.md decision 2 under specs/003-nlp-assistant/) — same value as
# nlp-assistant's own INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=change-me
