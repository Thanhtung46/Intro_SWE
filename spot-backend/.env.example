# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spot_dev
DB_USER=spot_user
DB_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h

# Payment Gateways
VNPAY_API_URL=https://sandbox.vnpayment.vn
VNPAY_API_KEY=your-key
MOMO_API_URL=https://sandbox.momoapi.com
MOMO_API_KEY=your-key

# Email
SENDGRID_API_KEY=your-key
SUPPORT_EMAIL=support@spot.local

# Firebase
FIREBASE_PROJECT_ID=your-project
FIREBASE_PRIVATE_KEY=your-key

# AWS S3
AWS_REGION=ap-southeast-1
AWS_BUCKET=spot-images
AWS_ACCESS_KEY=your-key
AWS_SECRET_KEY=your-secret

# External APIs
GOOGLE_MAPS_API_KEY=your-key
GEMINI_API_KEY=your-key
OPENAI_API_KEY=your-key

# AI Services
RECOMMENDATION_SERVICE_URL=http://localhost:5001
NOSHOW_SERVICE_URL=http://localhost:5002
NLP_SERVICE_URL=http://localhost:5003
