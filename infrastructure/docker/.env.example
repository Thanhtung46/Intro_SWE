# Copy to `.env` in this same folder before running docker compose.

# ---- PostgreSQL 16.3 ----
POSTGRES_USER=spot_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=spot
POSTGRES_PORT=5432

# ---- Redis 7.2.5 ----
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# ---- Host-side service ports ----
API_GATEWAY_PORT=4000
CORE_API_PORT=4001
AI_SERVICES_PORT=8000
WEB_CLIENT_PORT=3000
ADMIN_PORTAL_PORT=3001

# ---- AI Services (services/ai-services) ----
GOOGLE_API_KEY=

# NOTE: RS256 JWT key pair, OTP provider, and other auth secrets are
# intentionally not modeled here — owned by the Security Lead under
# services/core-api/src/modules/auth/ (see PROJECT_RULES.md §4).
